# Local development
DATABASE_URL=sqlite:///./fitness.db
# Production example:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fitness

# Required: at least 16 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_MINUTES=10080

# Optional: AI features return 503 until this is set
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
