{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    {
      "source": "/auth",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/auth/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/users",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/users/:path*",
      "destination": {
        "service": "backend"
      }
